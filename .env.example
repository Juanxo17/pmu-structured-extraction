# Proveedores de modelos — variables de entorno (T-05)
# Copiar como `.env` en la raiz del repo y completar los valores.
# NUNCA commitear el `.env` (esta en .gitignore).

# Clave de API de Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Modelo por defecto para el servicio de inferencia.
# La cuenta actual dispone de un catalogo restringido; ver docs/CONFIG_PROVEEDORES.md.
INFERENCE_MODELO=openai/gpt-oss-20b

# Reintentos y backoff del proveedor frente a errores 429/5xx
INFERENCE_INTENTOS_LLM=3
INFERENCE_ESPERA_BASE=1.0
INFERENCE_JITTER_MAX=0.5

# Registro de corridas de evaluacion en MLflow (opcional; si se omite no se registra)
# MLFLOW_TRACKING_URI=http://localhost:5000

# Ontologia inyectada en los prompts (default: config/ontologia.yaml)
# ONTOLOGIA_PATH=config/ontologia.yaml